# ==============================================================================
# RAG Engine - Environment Variables Configuration
# ==============================================================================
# This file is loaded automatically by Pydantic Settings in src/core/config.py.
# Modify the values below according to your deployment or development environment.

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="RAG Engine API"
API_V1_STR="/api/v1"
DEBUG=true

# ------------------------------------------------------------------------------
# 2. Database Settings (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# Docker compose maps the container port 5432 to host port 5434.
# Use option A when running the app locally on your host machine outside Docker.
# Use option B when running the app container inside Docker Compose.

# Option A: Local Host Development (outside Docker)
DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5434/rag_db

# Option B: Docker Compose Network (inside Docker container)
# DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@db:5432/rag_db

# Option C: Free Cloud PostgreSQL + pgvector (Neon.tech or Supabase) - see docs/free_cloud_databases_guide.md
# DATABASE_URL=postgresql+asyncpg://user:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=rag_db

# ------------------------------------------------------------------------------
# 3. Redis Cache & Quota Tracking
# ------------------------------------------------------------------------------
# Docker compose maps container port 6379 to host port 6380.

# Option A: Local Host Development (outside Docker)
REDIS_URL=redis://localhost:6380/0

# Option B: Docker Compose Network (inside Docker container)
# REDIS_URL=redis://redis:6379/0

# Option C: Free Cloud Serverless Redis (Upstash) - see docs/free_cloud_databases_guide.md
# REDIS_URL=rediss://default:your_secret_token@us1-quick-fox-12345.upstash.io:6379

# ------------------------------------------------------------------------------
# 4. Security & JWT Authentication
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 5. AI Providers & LLMs
# ------------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
DEFAULT_AI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# 6. File Storage (StorageFactory: "local" or "s3")
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# 7. AWS S3 / Cloudflare R2 / MinIO (Required only if STORAGE_BACKEND=s3)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
S3_BUCKET_NAME=
AWS_ENDPOINT_URL=
