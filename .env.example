# Application Settings
PROJECT_NAME="RAG Engine API"
API_V1_STR="/api/v1"
DEBUG=true

# Database (PostgreSQL with pgvector)
# Option A: When running inside Docker compose:
DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@db:5432/rag_db
# Option B: When running locally on host (outside Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5434/rag_db
# Option C: Free Cloud PostgreSQL (Neon.tech / Supabase with pgvector):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb

POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=rag_db

# Redis (Caching & Quotas)
# Option A: When running inside Docker compose:
REDIS_URL=redis://redis:6379/0
# Option B: When running locally on host (outside Docker):
# REDIS_URL=redis://localhost:6380/0
# Option C: Free Cloud Serverless Redis (Upstash):
# REDIS_URL=rediss://default:your_secret_token@us1-quick-fox-12345.upstash.io:6379

# Security & JWT
SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider (OpenAI)
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here

# File Storage ("local" or "s3")
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# AWS / S3 (Only needed if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
S3_BUCKET_NAME=
AWS_ENDPOINT_URL=
